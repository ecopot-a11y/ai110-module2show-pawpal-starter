classDiagram
    direction TB

    class Owner {
        +str name
        +int available_minutes
        +list pets
        +add_pet(pet)
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
    }

    class CareTask {
        +str title
        +int duration_minutes
        +str priority
        +describe() str
    }

    class Scheduler {
        +int available_minutes
        +generate_schedule(tasks) list
        +explain_plan(plan) str
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" CareTask : has tasks
    Scheduler ..> CareTask : schedules
    Owner ..> Scheduler : requests plan
